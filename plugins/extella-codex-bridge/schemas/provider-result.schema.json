{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "event_id",
    "status",
    "answer"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "provider": { "type": "string", "const": "codex" },
    "event_id": { "type": "string" },
    "status": { "type": "string", "const": "completed" },
    "answer": { "type": "string" }
  }
}
